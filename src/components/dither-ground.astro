<div class="dither-ground" aria-hidden="true" transition:persist="dither-ground">
  <canvas data-dither-ground></canvas>
</div>

<style>
  .dither-ground {
    width: 100%;
    height: clamp(300px, 48svh, 520px);
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent, black 48%);
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-dither-ground]");
  const context = canvas?.getContext("2d");

  if (canvas && context) {
    const root = document.documentElement;
    // Static layers are built once per resize/theme; frames only composite moving clouds between them.
    // All layers stay CPU-backed so per-frame drawImage + getImageData never forces a GPU readback.
    const layer = () => {
      const surface = document.createElement("canvas");
      return [surface, surface.getContext("2d", { willReadFrequently: true })!] as const;
    };
    const [scene, sceneContext] = layer();
    const [atmosphereLayer, atmosphereContext] = layer();
    // Stars + silhouettes on a transparent layer; source-over is associative, so this matches drawing them in sequence.
    const [front, p] = layer();
    const clouds: { image: HTMLCanvasElement; x: number; y: number; speed: number; width: number }[] = [];
    const bayer = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
    // Quantized channel value for each (Bayer threshold, input byte) pair.
    const levels = new Uint8Array(16 * 256);
    for (let step = 0; step < 16; step++) {
      for (let input = 0; input < 256; input++) {
        const value = input / 12;
        levels[step * 256 + input] = Math.min(255, (Math.floor(value) + (value % 1 > (step + 0.5) / 16 ? 1 : 0)) * 12);
      }
    }
    const noise = (x: number, y: number) => {
      const value = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
      return value - Math.floor(value);
    };
    const smoothNoise = (x: number, y: number) => {
      const ix = Math.floor(x);
      const iy = Math.floor(y);
      const fx = x - ix;
      const fy = y - iy;
      const sx = fx * fx * (3 - 2 * fx);
      const sy = fy * fy * (3 - 2 * fy);
      const top = noise(ix, iy) * (1 - sx) + noise(ix + 1, iy) * sx;
      const bottom = noise(ix, iy + 1) * (1 - sx) + noise(ix + 1, iy + 1) * sx;
      return top * (1 - sy) + bottom * sy;
    };
    const rgb = (hex: string) =>
      [1, 3, 5].map((offset) => Number.parseInt(hex.trim().slice(offset, offset + 2), 16));
    const mix = (a: number[], b: number[], amount: number) =>
      a.map((value, index) => Math.round(value + (b[index] - value) * amount));
    const css = (color: number[]) => `rgb(${color.join(",")})`;
    let dark = false;
    let width = 0;
    let height = 0;
    let bandTop = 0;
    let bandBottom = 0;
    let cloudOffset = 0;
    let previousTime = 0;
    let frame = 0;
    let visible = false;

    function buildClouds(background: number[], sky: number[]) {
      clouds.length = 0;
      bandTop = height;
      bandBottom = 0;
      if (!dark) return;
      const count = Math.max(5, Math.floor(width / 220));
      for (let index = 0; index < count; index++) {
        const seed = index + 67;
        const cloudWidth = 210 + noise(seed, 1) * 210;
        const cloudHeight = cloudWidth * (0.2 + noise(seed, 2) * 0.28);
        const [cloudSprite, cloudSpriteContext] = layer();
        cloudSprite.width = Math.ceil(cloudWidth);
        cloudSprite.height = Math.ceil(cloudHeight);
        const y = height * (0.16 + noise(seed, 4) * 0.26);
        clouds.push({ image: cloudSprite, x: (index / count) * width, y, speed: 0.3 + noise(seed, 3), width: cloudWidth });
        bandTop = Math.min(bandTop, Math.round(y));
        bandBottom = Math.min(height, Math.max(bandBottom, Math.round(y) + cloudSprite.height));
        const lobes = 4 + Math.floor(noise(seed, 5) * 4);
        const lobeShapes = Array.from({ length: lobes }, (_, lobe) => {
          const position = lobe / (lobes - 1);
          return {
            x: 0.2 + position * 0.6 + (noise(seed + lobe, 6) - 0.5) * 0.06,
            y: 0.62 - Math.sin(position * Math.PI) * (0.15 + noise(seed + lobe, 7) * 0.16),
            rx: 0.12 + noise(seed + lobe, 8) * 0.07,
            ry: 0.2 + noise(seed + lobe, 9) * 0.1,
          };
        });
        for (let py = 0; py < cloudSprite.height; py += 3) {
          for (let px = 0; px < cloudSprite.width; px += 3) {
            const nx = px / cloudSprite.width;
            const ny = py / cloudSprite.height;
            let shape = 1 - ((nx - 0.5) / 0.43) ** 2 - ((ny - 0.72) / 0.18) ** 2;
            let lighting = 0;
            for (const lobe of lobeShapes) {
              const dx = (nx - lobe.x) / lobe.rx;
              const dy = (ny - lobe.y) / lobe.ry;
              const surface = 1 - dx * dx - dy * dy;
              if (surface > shape) {
                shape = surface;
                lighting = -dx * 0.12 - dy * 0.24;
              }
            }
            shape += (noise(px + seed, py) - 0.5) * 0.035;
            if (shape <= 0) continue;
            const edge = Math.min(1, shape * 5);
            const undersideStart = 0.57 + Math.sin(nx * 14 + seed) * 0.045;
            const underside = Math.max(0, Math.min(1, (ny - undersideStart) / 0.36));
            const fade = (1 - underside) ** 1.5;
            cloudSpriteContext.fillStyle = css(mix(background, sky, 0.3));
            cloudSpriteContext.globalAlpha = edge * Math.sqrt(fade) * 0.45;
            cloudSpriteContext.fillRect(px, py, 3, 3);
            if (noise(px + seed, py + 13) > edge * fade) continue;
            const billow = Math.sin(nx * 13 + seed) * Math.sin(ny * 10) * 0.08;
            const illumination = 0.2 + Math.sqrt(shape) * 0.5 + lighting + billow - ny * 0.1;
            const tone = Math.max(0, Math.min(1,
              Math.round((illumination + (noise(px, py) - 0.5) * 0.12) * 9) / 9));
            cloudSpriteContext.fillStyle = css(mix(mix(background, sky, 0.28), mix(background, sky, 0.88), tone));
            cloudSpriteContext.globalAlpha = edge * Math.sqrt(fade) * 0.8;
            cloudSpriteContext.fillRect(px, py, 1, 1);
          }
        }
      }
    }

    function rebuild() {
      if (!canvas || !context) return;
      const bounds = canvas.getBoundingClientRect();
      if (!bounds.width || !bounds.height) return;
      width = Math.max(1, Math.round(bounds.width));
      height = Math.max(1, Math.round(bounds.height));
      canvas.width = scene.width = atmosphereLayer.width = front.width = width;
      canvas.height = scene.height = atmosphereLayer.height = front.height = height;
      const styles = getComputedStyle(root);
      const background = rgb(styles.getPropertyValue("--background"));
      const primary = rgb(styles.getPropertyValue("--primary"));
      const foreground = rgb(styles.getPropertyValue("--foreground"));
      dark = root.classList.contains("dark");
      const colored = ["teal", "azure", "crimson", "aurora"].some((theme) => root.classList.contains(theme));
      const sky = colored ? foreground : rgb(dark ? "#526885" : "#82b8dc");
      const light = colored ? primary : rgb(dark ? "#eed5a0" : "#f9edca");
      const ink = colored ? primary : rgb("#172735");
      const horizon = height * 0.83;
      const atmosphere = atmosphereContext.createImageData(width, height);
      for (let y = 0; y < height; y++) {
        const altitude = y / height;
        const haze = Math.max(0, 1 - Math.abs(altitude - 0.75) / 0.75);
        for (let x = 0; x < width; x++) {
          const grain = (noise(x, y) - 0.5) * 0.055;
          const amount = Math.max(0, Math.min(1,
            haze * (dark ? 0.3 : 0.38) + grain));
          const index = (y * width + x) * 4;
          for (let channel = 0; channel < 3; channel++) {
            atmosphere.data[index + channel] = background[channel]
              + (sky[channel] - background[channel]) * amount;
          }
          atmosphere.data[index + 3] = 255;
        }
      }
      atmosphereContext.putImageData(atmosphere, 0, 0);

      buildClouds(background, sky);

      if (dark) {
        for (let index = 0; index < Math.max(35, width / 13); index++) {
          const seed = index + 913;
          const x = Math.floor(noise(seed, 1) * width);
          const y = Math.floor(noise(seed, 2) * height * 0.6);
          const sparkle = noise(seed, 3) > 0.88;
          p.globalAlpha = 0.22 + noise(seed, 4) * 0.3;
          p.fillStyle = css(mix(background, foreground, 0.82));
          p.fillRect(x, y, sparkle ? 2 : 1, 1);
        }
        p.globalAlpha = 1;
      }

      // Draw broad, overlapping pixel ridges like a close forest canopy.
      const scale = height / 160;
      const worldWidth = Math.max(720, width / scale);
      p.save();
      p.translate((width - worldWidth * scale) / 2, 0);
      p.scale(scale, scale);
      const base = horizon / scale;
      p.fillStyle = css(mix(background, dark ? sky : ink, dark ? 0.18 : 0.12));
      p.beginPath();
      p.moveTo(0, 310);
      for (let x = 0; x <= worldWidth + 4; x += 2) {
        const ridge = base - 12 - Math.abs(Math.sin(x * 0.013 + 0.8) * 18)
          - Math.abs(Math.sin(x * 0.031 + 2.1) * 7)
          + (noise(x, 73) - 0.5) * 5;
        p.lineTo(x, ridge);
      }
      p.lineTo(worldWidth + 4, 310);
      p.closePath();
      p.fill();
      // Three depth layers: far towers fade into haze, near blocks are darker with brighter windows.
      const depths = [
        { step: 18, jitter: 6, width: [8, 10], height: [40, 90], tone: 0.24, side: 0.21, lit: 0.88, glow: 0.12 },
        { step: 30, jitter: 10, width: [13, 15], height: [28, 114], tone: 0.3, side: 0.21, lit: 0.68, glow: 0.38 },
        { step: 44, jitter: 14, width: [18, 14], height: [18, 52], tone: 0.17, side: 0.11, lit: 0.6, glow: 0.55 },
      ];
      const drawBuildings = (layer: number) => {
        const d = depths[layer];
        let x = -d.step * noise(layer, 9);
        for (let i = 0; x < worldWidth; i++) {
          const seed = i + layer * 71;
          x += d.step;
          const buildingX = x + noise(seed, 3) * d.jitter;
          const w = d.width[0] + Math.floor(noise(seed, 4) * d.width[1]);
          const h = d.height[0] + noise(seed, 5) ** 1.5 * d.height[1];
          // Only some near blocks appear, rooted behind the front treeline.
          if (layer === 2 && noise(seed, 7) < 0.35) continue;
          const bottom = base + (layer === 2 ? 14 + noise(seed, 6) * 6 : 0);
          const top = Math.floor(bottom - h);
          p.fillStyle = css(mix(background, dark ? sky : ink, d.tone));
          p.fillRect(buildingX, top, w, h);
          p.fillStyle = css(mix(background, dark ? sky : ink, d.side));
          p.fillRect(buildingX + w - Math.min(5, w / 3), top, Math.min(5, w / 3), h);
          p.fillRect(buildingX + 3, top - 3, w - 6, 3);
          if (h > 100) p.fillRect(buildingX + w / 2, top - 12, 0.7, 9);
          // Reference-style silhouettes on some towers: stepped setbacks, spires, and lit crowns.
          const style = layer ? noise(seed, 8) : 0;
          if (style > 0.55) {
            const tiers = style > 0.8 ? 2 : 1;
            for (let t = 1; t <= tiers; t++) {
              const tierW = w * (1 - t * 0.28);
              const tierH = 5 + noise(seed, 10 + t) * 8;
              const tierX = buildingX + (w - tierW) * (noise(seed, 12) > 0.5 ? 0.5 : 0.2);
              const tierTop = top - tierH * t;
              p.fillStyle = css(mix(background, dark ? sky : ink, d.tone - 0.02 * t));
              p.fillRect(tierX, tierTop, tierW, tierH);
              p.fillStyle = css(mix(background, light, d.glow + 0.1));
              for (let wy = tierTop + 2; wy < tierTop + tierH; wy += 2) {
                for (let wx = tierX + 1; wx < tierX + tierW - 1; wx += 2) {
                  if (noise(wx + seed, wy + t) > 0.6) p.fillRect(wx, wy, 2 / scale, 2 / scale);
                }
              }
              if (t === tiers && style > 0.9) {
                p.fillStyle = css(mix(background, dark ? sky : ink, d.side));
                p.fillRect(tierX + tierW / 2, tierTop - 14, 0.7, 14);
              }
            }
          }
          // Slanted roofs on a few blocks break up the flat tops.
          if (layer && style > 0.12 && style < 0.2) {
            const rise = 4 + noise(seed, 14) * 6;
            p.fillStyle = css(mix(background, dark ? sky : ink, d.tone));
            for (let sx = 0; sx < w; sx += 0.5) p.fillRect(buildingX + sx, top - rise * (sx / w), 0.5, rise * (sx / w));
          }
          // Red aviation beacon on the tallest towers.
          if (h > 95 && noise(seed, 15) > 0.4) {
            p.fillStyle = css(mix(background, colored ? primary : rgb("#e0574f"), 0.7));
            p.fillRect(buildingX + w / 2, top - (h > 100 ? 13 : 4), 1, 1);
          }
          if (layer && style > 0.3 && style < 0.42) {
            p.fillStyle = css(mix(background, light, d.glow + 0.25));
            p.fillRect(buildingX + 1, top + 1, w - 2, 0.7);
            p.fillRect(buildingX + 1, top + 3, w - 2, 0.5);
          }
          const tone = d.tone;
          const px = 2 / scale; // 2 screen pixels per grain cell
          // Far layer stays flat so it reads as haze; nearer layers get facade grain.
          for (let y = top; y < (layer ? bottom : top); y += px) {
            for (let wx = buildingX; wx < buildingX + w; wx += px) {
              const texture = noise(Math.round(wx / px) + seed * 19, Math.round(y / px) + layer * 31);
              const shade = ((wx - buildingX) / w) * 0.06;
              if (texture < 0.6) continue;
              p.fillStyle = css(mix(background, dark ? sky : ink, tone - shade + (texture > 0.9 ? 0.06 : -0.04)));
              p.fillRect(wx, y, px, px);
            }
          }
          // Floor slabs every few rows give the towers structure.
          p.fillStyle = css(mix(background, dark ? sky : ink, tone - 0.07));
          for (let y = top + 6; y < bottom; y += 6) p.fillRect(buildingX, y, w - 5, 0.5);
          // Residential towers get pale balcony bands every floor.
          if (layer && style > 0.42 && style < 0.55) {
            p.fillStyle = css(mix(background, dark ? sky : ink, tone + 0.1));
            for (let y = top + 2; y < bottom; y += 3) p.fillRect(buildingX, y, w - 3, 0.5);
          }
          // Small, dense windows on a 2-unit grid, occasionally lit in runs like occupied floors.
          for (let y = top + 3; y < bottom; y += 2) {
            const floorLit = noise(seed, y * 3) > 0.7 ? 0.2 : 0;
            for (let wx = buildingX + 2; wx < buildingX + w - 2; wx += 2) {
              const lit = noise(wx + seed, y) + floorLit;
              if (lit < d.lit) continue;
              p.fillStyle = css(mix(background, light, d.glow + Math.min(lit, 1) * 0.3));
              p.fillRect(wx, y, px, px);
            }
          }
          if (layer === 1 && i % 7 === 2) {
            p.fillStyle = css(mix(background, light, 0.5));
            p.fillRect(buildingX + 2, top + 1, w - 7, 0.7);
          }
        }
      };
      // Low, rounded tree crowns: a dark silhouette that swallows the building bases.
      const tint = colored ? foreground : (dark ? sky : ink);
      const treeTop = (x: number, layer: number) => {
        const size = layer ? 9 : 6;
        const cell = Math.floor(x / size);
        let lift = 0;
        for (let c = cell - 2; c <= cell + 2; c++) {
          const cx = (c + noise(c, layer * 7 + 41)) * size;
          const r = size * (0.7 + noise(c, layer * 7 + 42) * 0.8);
          const dx = x - cx;
          if (Math.abs(dx) < r) lift = Math.max(lift, Math.sqrt(r * r - dx * dx) * 0.8);
        }
        return base + (layer ? 12 : 1) - lift + Math.sin(x * 0.02 + layer * 3) * 3;
      };
      const drawTrees = (layer: number) => {
        const treeColor = mix(background, tint, layer ? 0.06 : 0.16);
        p.fillStyle = css(treeColor);
        p.beginPath();
        p.moveTo(0, 310);
        for (let x = 0; x <= worldWidth + 2; x += 1) p.lineTo(x, treeTop(x, layer));
        p.lineTo(worldWidth + 2, 310);
        p.closePath();
        p.fill();
        // Sparse 1px leaf highlights along the crowns only, so the band reads as foliage.
        p.fillStyle = css(mix(treeColor, tint, 0.12));
        for (let x = 0; x < worldWidth; x += 1) {
          const top = treeTop(x, layer);
          for (let y = Math.ceil(top); y < top + 6; y += 1) {
            if (noise(x + layer * 53, y) > 0.72) p.fillRect(x, y, 1, 1);
          }
        }
        // A few warm street lights glint through the back treeline.
        if (!layer) {
          for (let x = 5; x < worldWidth; x += 9) {
            if (noise(x, 211) < 0.86) continue;
            p.fillStyle = css(mix(background, light, 0.45 + noise(x, 212) * 0.3));
            p.fillRect(x, treeTop(x, 0) + 4 + noise(x, 213) * 5, 1, 1);
          }
        }
      };
      // Near blocks stand between the two treelines so the foreground has real depth.
      drawBuildings(0);
      drawBuildings(1);
      // Hand-placed Manila landmarks: PBCom Tower, Pacific Plaza twin towers, GT Tower.
      const body = mix(background, dark ? sky : ink, 0.3);
      const edge = mix(background, dark ? sky : ink, 0.21);
      const windows = (x0: number, y0: number, w: number, h: number, salt: number) => {
        for (let y = y0 + 2; y < y0 + h; y += 2) {
          for (let x = x0 + 2; x < x0 + w - 2; x += 2) {
            const lit = noise(x + salt, y);
            if (lit < 0.62) continue;
            p.fillStyle = css(mix(background, light, 0.4 + lit * 0.3));
            p.fillRect(x, y, 2 / scale, 2 / scale);
          }
        }
      };
      const tower = (x: number, w: number, h: number, salt: number) => {
        p.fillStyle = css(body);
        p.fillRect(x, base - h, w, h);
        p.fillStyle = css(edge);
        p.fillRect(x + w - 4, base - h, 4, h);
        windows(x, base - h, w - 4, h, salt);
      };
      // PBCom Tower: slim shaft, stepped crown, tall needle spire.
      const pb = worldWidth * 0.22;
      tower(pb, 18, 100, 501);
      p.fillStyle = css(body);
      p.fillRect(pb + 3, base - 108, 12, 8);
      p.fillRect(pb + 6, base - 114, 6, 6);
      p.fillStyle = css(edge);
      p.fillRect(pb + 8.6, base - 128, 0.8, 14);
      p.fillStyle = css(mix(background, light, 0.75));
      p.fillRect(pb + 3, base - 101, 12, 0.6);
      // Pacific Plaza Towers: twin slabs.
      const pp = worldWidth * 0.55;
      for (const [offset, h] of [[0, 92], [22, 98]]) {
        const x = pp + offset;
        tower(x, 17, h, 600 + offset);
      }
      // Rockwell Center cluster: Edades Tower's open-frame crown, Proscenium's curved slabs, Power Plant stack.
      const rw = worldWidth * 0.38;
      tower(rw, 15, 96, 800);
      p.fillStyle = css(edge);
      p.fillRect(rw, base - 108, 0.8, 12);
      p.fillRect(rw + 14.2, base - 108, 0.8, 12);
      p.fillRect(rw, base - 108, 15, 0.8);
      p.fillStyle = css(mix(background, light, 0.6));
      for (let fy = base - 105; fy < base - 96; fy += 3) p.fillRect(rw + 1, fy, 13, 0.4);
      for (const [offset, h, salt] of [[19, 78, 810], [34, 70, 820]]) {
        tower(rw + offset, 13, h, salt);
        for (let row = 0; row < 5; row += 0.5) {
          p.fillStyle = css(body);
          p.fillRect(rw + offset, base - h - row, 13 * (1 - (row / 5) ** 2), 0.5);
        }
      }
      p.fillStyle = css(edge);
      p.fillRect(rw - 8, base - 58, 3, 58);
      p.fillStyle = css(mix(background, light, 0.45));
      p.fillRect(rw - 8, base - 54, 3, 0.5);
      p.fillRect(rw - 8, base - 50, 3, 0.5);
      // GT Tower: broad shaft that tapers into a rounded, slit crown.
      const gt = worldWidth * 0.8;
      tower(gt, 22, 104, 700);
      for (let row = 0; row < 12; row += 0.5) {
        const half = 11 * Math.sqrt(1 - (row / 12) ** 2);
        p.fillStyle = css(body);
        p.fillRect(gt + 11 - half, base - 104 - row, half * 2, 0.5);
      }
      p.fillStyle = css(mix(background, light, 0.7));
      p.fillRect(gt + 10.6, base - 114, 0.8, 9);
      drawTrees(0);
      drawBuildings(2);
      drawTrees(1);
      p.restore();
      compose(0, height);
    }

    // Composites rows [top, top + rows) and dithers only those, so cloud frames skip the static ground.
    function compose(top: number, rows: number) {
      if (!context || rows <= 0) return;
      sceneContext.drawImage(atmosphereLayer, 0, top, width, rows, 0, top, width, rows);
      for (const cloud of clouds) {
        const x = ((cloud.x + cloudOffset * cloud.speed + cloud.width) % (width + cloud.width)) - cloud.width;
        sceneContext.drawImage(cloud.image, Math.round(x), Math.round(cloud.y));
      }
      sceneContext.drawImage(front, 0, top, width, rows, 0, top, width, rows);

      // Ordered quantization makes gradients and silhouettes share the sky's pixel texture.
      const pixels = sceneContext.getImageData(0, top, width, rows);
      const data = pixels.data;
      for (let y = 0; y < rows; y++) {
        const row = ((top + y) % 4) * 4;
        for (let x = 0; x < width; x++) {
          const step = bayer[row + (x % 4)] * 256;
          const index = (y * width + x) * 4;
          data[index] = levels[step + data[index]];
          data[index + 1] = levels[step + data[index + 1]];
          data[index + 2] = levels[step + data[index + 2]];
        }
      }
      context.putImageData(pixels, 0, top);
    }

    // Clouds drift at most ~10px/s and snap to whole pixels, so 15fps shows every step.
    function animate(time: number) {
      frame = 0;
      if (!visible || document.hidden || !dark) return;
      if (time - previousTime >= 1000 / 15) {
        if (previousTime) cloudOffset = (cloudOffset + Math.min(time - previousTime, 200) * 0.008) % 2000;
        previousTime = time;
        compose(bandTop, bandBottom - bandTop);
      }
      frame = requestAnimationFrame(animate);
    }

    function updateAnimation() {
      cancelAnimationFrame(frame);
      frame = 0;
      previousTime = 0;
      if (visible && !document.hidden && dark) frame = requestAnimationFrame(animate);
    }

    const theme = () => ["dark", "teal", "azure", "crimson", "aurora"].filter((name) => root.classList.contains(name)).join();
    let currentTheme = theme();
    // ResizeObserver also fires once on observe, which handles the first build.
    new ResizeObserver(rebuild).observe(canvas);
    new MutationObserver(() => {
      // Ignore unrelated <html> classes such as preload/scroll-restoring.
      if (theme() === currentTheme) return;
      currentTheme = theme();
      rebuild();
      updateAnimation();
    }).observe(root, {
      attributes: true,
      attributeFilter: ["class"],
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      updateAnimation();
    }).observe(canvas);
    document.addEventListener("visibilitychange", updateAnimation);
  }
</script>
