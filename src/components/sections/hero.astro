---
import { Image } from "astro:assets";
import profilePicture from "@/assets/profile-picture.webp";
import { experiences } from "@/components/sections/experiences-data";
import { publishedProjects } from "@/components/sections/projects-data";
import SectionTitle from "@/components/section-title.astro";
import Link from "@/components/ui/link.astro";

const professionalStartDate = new Date(2025, 4);
const currentDate = new Date();
const professionalExperienceMonths =
  (currentDate.getFullYear() - professionalStartDate.getFullYear()) * 12 +
  currentDate.getMonth() -
  professionalStartDate.getMonth();
const professionalExperienceYears =
  Math.ceil((professionalExperienceMonths / 12) * 2) / 2;

const stats = [
  { value: professionalExperienceYears, label: "years" },
  { value: experiences.length, label: "industries" },
  { value: publishedProjects.length, label: "projects" },
];
---

<header class="flex flex-col items-start spacing-lg mt-10">
  <div class="flex w-full items-center spacing-lg">
    <div class="dither size-35 shrink-0 select-none border">
      <Image
        src={profilePicture}
        width={280}
        height={280}
        format="webp"
        quality="high"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        draggable="false"
        class="size-full object-cover"
        alt="Cyril James - Full-Stack Engineer"
      />
    </div>

    <div class="flex flex-col justify-center spacing-xs">
      <SectionTitle text="Cyril James" class="text-3xl" />

      <div class="flex flex-col spacing-xs lg:flex-row">
        <p class="flex spacing-xs">
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" class="size-5"><path fill="currentColor" d="M8 3h8v4h6v14H2V7h6zm2 4h4V5h-4zM4 9v10h16V9zm4 2v6H6v-6zm10 0v6h-2v-6z"></path></svg>
          Full-Stack Engineer
        </p>
        <p class="flex spacing-xs">
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" class="size-5"><path fill="currentColor" d="M15 8v2h-1v1h-1v1h-2v-1h-1v-1H9V8h1V7h1V6h2v1h1v1z" stroke="currentColor"></path><path fill="currentColor" d="M19 6V4h-1V3h-1V2h-2V1H9v1H7v1H6v1H5v2H4v6h1v2h1v1h1v2h1v1h1v2h1v1h1v2h2v-2h1v-1h1v-2h1v-1h1v-2h1v-1h1v-2h1V6zm-2 6v2h-1v1h-1v2h-1v1h-1v2h-2v-2h-1v-1H9v-2H8v-1H7v-2H6V6h1V4h2V3h6v1h2v2h1v6z" stroke="currentColor"></path></svg>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Bataan%2C%20Philippines"
            class="underline underline-offset-2"
            target="_blank"
            rel="noopener noreferrer"
          >
            Bataan, Philippines
          </a>
        </p>
      </div>

      <nav class="hidden flex-row spacing-xs uppercase lg:flex" aria-label="Social and Resume links">
        <Link
          href="https://github.com/quinchy"
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
        >
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" class="size-5"><path fill="currentColor" d="M5 2h4v2H7v2H5zm0 10H3V6h2zm2 2H5v-2h2zm2 2v-2H7v2H3v-2H1v2h2v2h4v4h2v-4h2v-2zm0 0v2H7v-2zm6-12v2H9V4zm4 2h-2V4h-2V2h4zm0 6V6h2v6zm-2 2v-2h2v2zm-2 2v-2h2v2zm0 2h-2v-2h2zm0 0h2v4h-2z" stroke="currentColor"></path></svg>
          GitHub
        </Link>

        <Link
          href="https://www.linkedin.com/in/quinchy"
          target="_blank"
          rel="noopener noreferrer"
          variant="outline"
        >
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="32" height="32" viewBox="0 0 32 32" class="size-5"><path fill="currentColor" d="M30.47 3.05H32v25.9h-1.53Zm-1.52 25.9h1.52v1.53h-1.52Zm0-27.43h1.52v1.53h-1.52Zm-1.53 3.05h1.53v22.86h-1.53ZM3.04 30.48h25.91V32H3.04Zm1.53-3.05h22.85v1.52H4.57Zm18.28-12.19h-1.52v-1.53h-3.05v1.53h-1.52v-1.53h-3.05v9.15h3.05v-4.57h1.52v-1.53h1.53v1.53h1.52v4.57h3.05v-6.1h-1.53zM7.61 13.71h3.05v9.15H7.61Zm0-4.57h3.05v3.05H7.61ZM4.57 3.05h22.85v1.52H4.57ZM3.04 0h25.91v1.52H3.04Zm0 4.57h1.53v22.86H3.04ZM1.52 28.95h1.52v1.53H1.52Zm0-27.43h1.52v1.53H1.52ZM0 3.05h1.52v25.9H0Z" stroke="currentColor"></path></svg>
          LinkedIn
        </Link>

        <Link
          href="/cyril-james-resume.pdf"
          target="_blank"
          aria-label="Download Cyril James Resume PDF"
          variant="outline"
          rel="noopener noreferrer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" class="size-5"><path fill="currentColor" d="M6 3h14v2h2v6h-2v8h-2V5H6zm8 14v-2H6V5H4v10H2v4h2v2h14v-2h-2v-2zm0 0v2H4v-2zM8 7h8v2H8zm8 4H8v2h8z" stroke="currentColor"></path></svg>
          Resume
