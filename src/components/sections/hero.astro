      </nav>
    </div>

    <aside
      class="ml-auto hidden min-w-56 flex-col border border-dashed border-border text-sm lg:flex"
      aria-label="Career stats and local time"
    >
      <dl class="grid grid-cols-3">
        {
          stats.map(({ value, label }) => (
            <div class="flex flex-col border-r border-dashed border-border padding-sm last:border-r-0">
              <dt class="order-last text-xs text-foreground/60">{label}</dt>
              <dd class="text-3xl font-semibold text-primary">{value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="flex justify-between spacing-xs border-t border-dashed border-border padding-sm text-xs text-foreground/60">
        <span class="flex items-center spacing-xs" data-status>
          <span class="status-dot size-2.5 shrink-0" aria-hidden="true"></span>
          <span data-status-label></span>
        </span>
        <span><time data-local-time>--:--</time> UTC+8</span>
      </p>
    </aside>
  </div>

  <nav class="flex flex-row spacing-xs uppercase lg:hidden" aria-label="Social and Resume links">
    <Link
      href="https://github.com/quinchy"
      target="_blank"
      rel="noopener noreferrer"
      variant="outline"
    >
      <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" class="size-5"><path fill="currentColor" d="M5 2h4v2H7v2H5zm0 10H3V6h2zm2 2H5v-2h2zm2 2v-2H7v2H3v-2H1v2h2v2h4v4h2v-4h2v-2zm0 0v2H7v-2zm6-12v2H9V4zm4 2h-2V4h-2V2h4zm0 6V6h2v6zm-2 2v-2h2v2zm-2 2v-2h2v2zm0 2h-2v-2h2zm0 0h2v4h-2z" stroke="currentColor"></path></svg>
      GitHub
    </Link>

    <Link
      href="https://www.linkedin.com/in/quinchy"
      target="_blank"
      rel="noopener noreferrer"
      variant="outline"
    >
      <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="32" height="32" viewBox="0 0 32 32" class="size-5"><path fill="currentColor" d="M30.47 3.05H32v25.9h-1.53Zm-1.52 25.9h1.52v1.53h-1.52Zm0-27.43h1.52v1.53h-1.52Zm-1.53 3.05h1.53v22.86h-1.53ZM3.04 30.48h25.91V32H3.04Zm1.53-3.05h22.85v1.52H4.57Zm18.28-12.19h-1.52v-1.53h-3.05v1.53h-1.52v-1.53h-3.05v9.15h3.05v-4.57h1.52v-1.53h1.53v1.53h1.52v4.57h3.05v-6.1h-1.53zM7.61 13.71h3.05v9.15H7.61Zm0-4.57h3.05v3.05H7.61ZM4.57 3.05h22.85v1.52H4.57ZM3.04 0h25.91v1.52H3.04Zm0 4.57h1.53v22.86H3.04ZM1.52 28.95h1.52v1.53H1.52Zm0-27.43h1.52v1.53H1.52ZM0 3.05h1.52v25.9H0Z" stroke="currentColor"></path></svg>
      LinkedIn
    </Link>

    <Link
      href="/cyril-james-resume.pdf"
      target="_blank"
      aria-label="Download Cyril James Resume PDF"
      variant="outline"
      rel="noopener noreferrer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" class="size-5"><path fill="currentColor" d="M6 3h14v2h2v6h-2v8h-2V5H6zm8 14v-2H6V5H4v10H2v4h2v2h14v-2h-2v-2zm0 0v2H4v-2zM8 7h8v2H8zm8 4H8v2h8z" stroke="currentColor"></path></svg>
      Resume
    </Link>
  </nav>
</header>

<script>
  // Live Bataan time and availability. One interval for the session; page-load re-fills it after client-side navigation.
  const format = new Intl.DateTimeFormat("en-US", { timeZone: "Asia/Manila", hour: "numeric", minute: "2-digit" });
  const hours = new Intl.DateTimeFormat("en-US", { timeZone: "Asia/Manila", hour: "numeric", hourCycle: "h23" });
  const tick = () => {
    const now = new Date();
    const hour = Number(hours.format(now));
    // Offline 9 PM-7:59 AM; idle over lunch (12 PM) and 5-7 PM; online the rest of the day.
    const status = hour >= 21 || hour < 8 ? "Offline" : hour === 12 || (hour >= 17 && hour < 19) ? "Idle" : "Online";
    for (const clock of document.querySelectorAll("[data-local-time]")) clock.textContent = format.format(now);
    for (const badge of document.querySelectorAll<HTMLElement>("[data-status]")) {
      badge.dataset.status = status.toLowerCase();
      badge.querySelector("[data-status-label]")!.textContent = status;
    }
  };
  document.addEventListener("astro:page-load", tick);
  setInterval(tick, 30_000);
</script>

<style>
  /* Pixel status light: a solid core inside a dithered halo, like the sky's sun and moon glow. */
  .status-dot {
    --dot: color-mix(in srgb, var(--foreground) 40%, transparent);
    background:
      linear-gradient(var(--dot), var(--dot)) center / 6px 6px no-repeat,
      repeating-conic-gradient(var(--dot) 0 25%, transparent 0 50%) 0 0 / 2px 2px;
  }
  [data-status="online"] .status-dot {
    --dot: #22c55e;
  }
  [data-status="idle"] .status-dot {
    --dot: #eab308;
  }
  /* Color themes light up in their own primary; default keeps green/amber since its primary is plain black/white. */
  :global(:root:is(.teal, .azure, .crimson, .aurora)) [data-status="online"] .status-dot {
    --dot: var(--primary);
  }
  :global(:root:is(.teal, .azure, .crimson, .aurora)) [data-status="idle"] .status-dot {
    --dot: color-mix(in srgb, var(--primary) 50%, transparent);
  }
</style>
