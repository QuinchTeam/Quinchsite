---
import { Image } from "astro:assets";
import appquantLogo from "@/assets/companies/appquant.webp";
import kynatechLogo from "@/assets/companies/kynatech.webp";
import pioneerLogo from "@/assets/companies/pioneer-dev-ai.webp";
import thorneLogo from "@/assets/companies/thorne-consulting.webp";
import SectionTitle from "@/components/section-title.astro";
import Badge from "@/components/ui/badge.astro";
import Link from "@/components/ui/link.astro";

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

interface Experience {
  title: string;
  period: string;
  company: string;
  companyLogo?: ImageMetadata;
  companyLink?: string;
  employmentType: string;
  location: string;
  workMode: string;
  descriptions: string[];
  technologies: string[];
}

const experiences: Experience[] = [
  {
    title: "Full-Stack Engineer",
    period: "September 2026 - Present",
    company: "Thorne Consulting",
    companyLink: "https://thorneconsultingco.com/",
    companyLogo: thorneLogo,
    employmentType: "Full-time",
    location: "Houston, Texas, United States",
    workMode: "Remote",
    descriptions: [
      "Building a modern, AI-powered Career and Education Platform that reimagines how K-12 students explore career paths, build practical skills, and prepare for the workplace through interactive experiences. Working across a cutting-edge stack of Next.js, Prisma, Mastra, Inngest, and other distributed services, while optimizing Voice AI and LLM outputs for natural, engaging interactions.",
    ],
    technologies: [
      "Next.js",
      "Prisma",
      "Mastra",
      "Inngest",
      "OpenTelemetry",
      "BetterStack",
      "Dokploy",
      "Voice AI",
      "LLM",
    ],
  },
  {
    title: "Full-Stack Engineer",
    period: "March 2026 - Present",
    company: "Pioneer Dev AI",
    companyLink: "https://pioneerdev.ai/",
    companyLogo: pioneerLogo,
    employmentType: "Full-time",
    location: "Boulder, Colorado, United States",
    workMode: "Remote",
    descriptions: [
      "Building AI and SaaS products for startups across different industries, contributing to multiple projects spanning frontend, backend, and DevOps. Shipping with Next.js, React Router, Fastify, Astro, Prisma, PostgreSQL, Cloudflare, Fly.io, and other modern technologies and integrations.",
    ],
    technologies: [
      "Next.js",
      "Prisma",
      "Supabase",
      "tRPC",
      "Trigger.dev",
      "Cloudflare",
      "Redis",
      "Sentry",
      "Langfuse",
      "Infisical",
      "AI Generation",
    ],
  },
  {
    title: "Software Developer",
    period: "May 2025 - Feb 2026",
    company: "AppQuant Technologies Inc.",
    companyLogo: appquantLogo,
    employmentType: "Full-time",
    location: "Pasig City, Philippines",
    workMode: "Remote",
    descriptions: [
      "As one of the Founding Engineers at a startup, led the development and infrastructure of a modern AI-powered CRM, from its web platform to its backend APIs. Built on Next.js, Prisma, PostgreSQL (Supabase), and Vercel, integrating third-party services such as Stripe, Twilio, Resend, ElevenLabs, and OpenAI.",
    ],
    technologies: [
      "Next.js",
      "Supabase",
      "Prisma",
      "Vercel",
      "OpenAI",
      "Elevenlabs",
      "Stripe",
      "Resend",
      "Twilio",
      "Shadcn",
    ],
  },
  {
    title: "Software Developer Intern",
    period: "October 2024 - November 2024",
    company: "Kynatech",
    companyLogo: kynatechLogo,
    companyLink: "https://kynatech.ph/",
    employmentType: "Internship",
    location: "Taguig City, Philippines",
    workMode: "Remote",
    descriptions: [
      "Built a full-stack Timesheet Application under the mentorship of senior engineers, turning complex Figma designs into responsive, pixel-accurate interfaces. Collaborated within a multidisciplinary team of designers, developers, QA testers, DevOps engineers, and project managers delivering web and mobile products.",
    ],
    technologies: ["Next.js", "Supabase", "Prisma", "Shadcn"],
  },
];
const visibleExperiences = experiences.slice(0, limit);
---

<section class="flex flex-col spacing-md">
  <SectionTitle text={`Experiences (${experiences.length})`} />

  <div class="flex flex-col spacing-lg">
    {
      visibleExperiences.map((experience) => (
        <article class="group flex flex-col spacing-md">
          <div class="flex flex-col spacing-xs lg:flex-row lg:items-center">
            {experience.companyLogo ? (
              <div class="dither size-20 shrink-0 border border-border outline-1 outline-dashed outline-transparent outline-offset-xs animation-normal group-hover:outline-border">
                <Image
                  width={160}
                  format="webp"
                  quality={100}
                  src={experience.companyLogo}
                  draggable="false"
                  loading="lazy"
                  class="size-full select-none object-cover"
                  alt={`${experience.company} logo`}
                />
              </div>
            ) : (
              <div class="flex min-h-20 min-w-20 items-center justify-center border border-border bg-muted">
                <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" class="size-10 text-primary/50"><path fill="currentColor" d="M2 2h14v4h6v16H2zm18 6h-4v2h2v2h-2v2h2v2h-2v2h2v2h2zm-6-4H4v16h2v-2h6v2h2zM6 6h2v2H6zm6 0h-2v2h2zm-6 4h2v2H6zm6 0h-2v2h2zm-6 4h2v2H6zm6 0h-2v2h2z"></path></svg>
              </div>
            )}
            <header class="w-full border-b border-dashed border-transparent mt-2 lg:mt-0 lg:padding-md animation-normal group-hover:border-border">
              <div class="flex flex-col justify-between lg:flex-row">
                <h2 class="font-semibold text-primary">{experience.title}</h2>
                <time class="text-primary">{experience.period}</time>
              </div>
              <div class="flex flex-col justify-between lg:flex-row">
                <div class="flex spacing-xs">
                  {experience.companyLink ? (
                    <a
                      href={experience.companyLink}
                      class="text-primary underline underline-offset-2"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {experience.company}
                    </a>
                  ) : (
                    <span class="text-primary">{experience.company}</span>
                  )}
                  <span>|</span>
                  <span>{experience.employmentType}</span>
                </div>
                <address class="flex spacing-xs not-italic">
                  <span>{experience.location}</span>
                  <span>|</span>
                  <span>{experience.workMode}</span>
                </address>
              </div>
            </header>
          </div>
          <section class="flex flex-col spacing-xs">
            {experience.descriptions.map((desc) => (
              <p class="text-foreground/80">{desc}</p>
            ))}
          </section>
          <ul class="flex flex-wrap spacing-xs">
            {experience.technologies.map((tech) => (
              <li>
                <Badge name={tech} />
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
  {
    limit && limit < experiences.length && (
      <div class="flex justify-center">
        <Link href="/experiences" variant="dashed" class="w-full animation-normal">
          View All Experiences
        </Link>
      </div>
    )
  }
</section>
