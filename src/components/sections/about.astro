---
import SectionTitle from "@/components/section-title.astro";

// Preferred go-to tools, shown as a stack grid for quick scanning.
const stack = [
  { role: "Frontend / Full-Stack", name: "Next.js" },
  { role: "Backend framework", name: "NestJS" },
  { role: "AI services", name: "FastAPI" },
  { role: "Static sites", name: "Astro" },
  { role: "ORM", name: "Prisma" },
  { role: "Database / Cache", name: "PostgreSQL / Redis" },
  { role: "Storage / CDN", name: "S3" },
  { role: "Observability", name: "OpenTelemetry + Sentry" },
  { role: "Hosting / Infra", name: "Cloudflare / GCP" },
];
---

<article class="flex flex-col spacing-md">
  <SectionTitle text="About" />

  <p class="text-foreground/80">
    I'm a Full-Stack Engineer who loves building AI and SaaS products end to end, from frontend and
    backend to DevOps. I care about scalable, reliable systems and intuitive user experiences, and I
    thrive in fast-moving startups across different industries.
  </p>

  <div class="flex flex-col spacing-xs">
    <h3 class="text-sm text-foreground/60">Current go-to stack</h3>
    <ul class="grid grid-cols-2 border-t border-l border-dashed border-border sm:grid-cols-3">
      {
        stack.map(({ role, name }) => (
          <li class="flex flex-col border-r border-b border-dashed border-border padding-sm animation-normal last:col-span-2 hover:bg-muted sm:last:col-span-1">
            <span class="text-xs text-foreground/60">{role}</span>
            <span class="font-semibold text-primary">{name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</article>
